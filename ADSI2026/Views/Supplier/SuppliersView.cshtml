@model IEnumerable<MVC.Infrastructure.Models.Supplier>

<h1>Suppliers</h1>

<div class="row">
    <div class="col-md-12">
        <table class="table" id="tblSuppliers">
            <thead class="thead-dark">
                <tr>
                    <th>Company</th>
                    <th>Contact Name</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th>City</th>
                    <th>Country</th>
                </tr>
            </thead>
            <tbody>
                <tr></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        var idCustomer='';
        var listCustomer=[];

        $(document).ready(function(){
            console.log("Hola clase");
            getAllSuppliers();

        });

        function getAllSuppliers(){
            $.ajax({
                url: '@Url.Action("GetAllSuppliers", "Supplier")',
                method:'GET',
                dataType: 'json',
                success: function(result)
                {

                console.log(result);
                loadTable(result);
                },
                error: function(error){
                    console.error(error);
                }
            });
        }

        function loadTable(data){
            $('#tblSuppliers').DataTable({
                data:data,
                destroy:true,
                responsitive:true,
                columns:[
                    {data:'companyName'},
                    {data:'contactName'},
                    {data:'phone'},
                    {data:'address'},
                    {data:'city'},
                    {data:'country'},
                ]
            })
        }
    </script>
}
